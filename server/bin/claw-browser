#!/usr/bin/env node
// claw-browser — agent-facing thin shim around the Playwright agent CLI.
//
// What the agent runs:        claw-browser open https://example.com
// What actually executes:     IPC to playwrightSessionManager via unix socket
//                             which serializes commands per-workspace, ensures
//                             the chat's tab exists & is selected, honors the
//                             pause flag, then runs the underlying playwright-cli.
//
// Read by the shim from the agent's environment (set by getChildEnv):
//   CLAW_PROJECT_ID  — workspace identifier; selects the dashboard IPC socket
//   CLAW_CHAT_ID     — chat the command belongs to; selects the tab
//   CLAW_TAB         — derived tab id (chat_<chatId>) — kept for parity with playwright-cli's tab-name model
//
// This file is intentionally dependency-free (only Node stdlib) so it runs in
// any agent shell environment without bundling.

import net from 'node:net';
import os from 'node:os';
import path from 'node:path';
import process from 'node:process';

const projectId = process.env.CLAW_PROJECT_ID;
const chatId = process.env.CLAW_CHAT_ID;
const tabId = process.env.CLAW_TAB || (chatId ? `chat_${chatId}` : null);

if (!projectId || !chatId) {
  process.stderr.write(
    'claw-browser: missing CLAW_PROJECT_ID / CLAW_CHAT_ID env. ' +
    'This shim must be invoked from inside a dashboard-spawned agent shell.\n',
  );
  process.exit(2);
}

const args = process.argv.slice(2);
if (args.length === 0) {
  process.stderr.write(
    'Usage: claw-browser <subcommand> [args]\n' +
    'Common: open <url> | snapshot | click <ref> | fill <ref> <text> | type <text>\n' +
    '        viewport <desktop|tablet|mobile> | back | reload | screenshot\n' +
    'See `playwright-cli --help` for the full surface; claw-browser forwards directly.\n',
  );
  process.exit(2);
}

const socketPath = path.join(os.tmpdir(), `claw-browser-${projectId}.sock`);

const payload = JSON.stringify({
  type: 'exec',
  projectId,
  chatId,
  tabId,
  argv: args,
  cwd: process.cwd(),
});

const conn = net.createConnection(socketPath);
let buf = '';
let exitCode = 1;

conn.on('connect', () => {
  conn.write(payload + '\n');
});

conn.on('data', (chunk) => {
  buf += chunk.toString('utf8');
  let idx;
  while ((idx = buf.indexOf('\n')) !== -1) {
    const line = buf.slice(0, idx);
    buf = buf.slice(idx + 1);
    if (!line) continue;
    let msg;
    try { msg = JSON.parse(line); } catch { continue; }
    if (msg.type === 'stdout') process.stdout.write(msg.data);
    else if (msg.type === 'stderr') process.stderr.write(msg.data);
    else if (msg.type === 'exit') {
      exitCode = typeof msg.code === 'number' ? msg.code : 1;
      conn.end();
    }
    else if (msg.type === 'error') {
      process.stderr.write(`claw-browser: ${msg.message}\n`);
      exitCode = msg.code ?? 1;
      conn.end();
    }
  }
});

conn.on('error', (err) => {
  // ENOENT = no listener = dashboard isn't running or browser feature disabled.
  // EACCES = socket permission issue.
  process.stderr.write(
    `claw-browser: cannot reach dashboard browser service (${err.code || err.message}).\n` +
    'Is the dashboard running, and is browser automation enabled (DASHBOARD_ENV=local)?\n',
  );
  process.exit(3);
});

conn.on('close', () => {
  process.exit(exitCode);
});
